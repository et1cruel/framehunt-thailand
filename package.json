{
  "name": "framehunt-thailand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FRAMEHUNT THAILAND — cinematic location discovery for music videos, film and photography.",
  "scripts": {
    "prepare:catalog": "node scripts/prepare-location-catalog.mjs",
    "dev": "vite",
    "predev": "npm run prepare:catalog",
    "prebuild": "npm run prepare:catalog && node scripts/gen-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run prepare:catalog",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run prepare:catalog",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:preview": "node scripts/verify-preview.mjs",
    "ingest": "node scripts/ingest/run.mjs",
    "ingest:expand": "node scripts/ingest/run.mjs --expand",
    "ingest:verify": "node scripts/ingest/verify.mjs",
    "data:build": "node scripts/build-data.mjs",
    "gen:assets": "node scripts/render-assets.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:taxonomy": "node scripts/gen-taxonomy-seed.mjs",
    "db:seed": "node scripts/seed-locations.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "^5.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^17.14.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
