# ---------------------------------------------------------------------------
# FRAMEHUNT THAILAND — environment template
# Copy to `.env.local` for the frontend and `.dev.vars` for Pages Functions.
# Never commit real keys. Anything prefixed VITE_ is shipped to the browser.
# ---------------------------------------------------------------------------

# Public Supabase project (safe to expose; protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local-only demo mode: when Supabase is not configured the app uses an
# on-device account/store so favourites and boards still work. Set to
# "false" in production to force real authentication.
VITE_ALLOW_LOCAL_MODE=true

# Map tiles — OpenFreeMap needs no key. Override with any MapLibre style URL.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Server-side only (Cloudflare Pages Functions / .dev.vars) --------------
# The service-role key bypasses RLS. It must never be prefixed with VITE_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SITE_URL=https://framehunt.co
# ADMIN_BOOTSTRAP_EMAIL=
#
# Optional KV binding for per-IP rate limiting (see wrangler.toml).
# SUBMISSION_RATE_LIMIT=

# --- Ingestion (scripts/ingest) --------------------------------------------
# Wikimedia requires a descriptive User-Agent with contact info.
WIKIMEDIA_USER_AGENT=FrameHuntThailand/0.1 (https://framehunt.co; ops@framehunt.co)
# Optional: Google Places (only used where Terms allow, never stored in R2)
GOOGLE_PLACES_API_KEY=
