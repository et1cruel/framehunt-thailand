  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://commons.wikimedia.org https://images.ra.co https://bangkokisland.com https://iicbangkok.esteri.it https://images.squarespace-cdn.com https://static.wixstatic.com https://prod-pics.guide.michelin.com https://cdnali.zipeventapp.com https://storage.googleapis.com https://files.thailandtourismdirectory.go.th https://media.timeout.com https://sombatpermpoongallery.com https://www.chiangmailocator.com https://static.naewna.com https://www.trefac-th.com https://ragtagthailand.com https://media.nationthailand.com https://greener.bangkok.go.th https://content.phuket101.net https://www.make-my-bangkok-holiday.com https://thriftspots.com https://ak-d.tripcdn.com https://bangkok.biz https://p16-va.lemon8cdn.com https://www.mixtchatuchak.com https://www.fashionisland.co.th https://admin.iameverything.co https://assets.st-note.com https://kvillagebangkok.com https://sammiegonesolo.com https://shopblocstore.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tiles.openfreemap.org https://*.tile.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og-default.png
  Cache-Control: public, max-age=604800

/api/*
  Cache-Control: no-store
